<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="oriontv.exe"
        Arguments=""
        InstallLocation="C:\Program Files\MorenoLand\OrionTV">
    </Installer>
    <PackageInformation
        PackageName="OrionTV"
        PackageDisplayName="OrionTV"
        PublisherName="CN=MorenoLand"
        PublisherDisplayName="MorenoLand"
        Version="1.0.0.0"
        PackageDescription="OrionTV desktop client for the Moreno Land live channel.">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="land.moreno.oriontv"
                Description="OrionTV desktop client for the Moreno Land live channel."
                DisplayName="OrionTV"
                ExecutableName="oriontv.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>OrionTV</DisplayName>
            <PublisherDisplayName>MorenoLand</PublisherDisplayName>
            <Description>OrionTV desktop client for the Moreno Land live channel.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="oriontv.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
