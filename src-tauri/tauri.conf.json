{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "OrionTV",
  "version": "1.0.0",
  "identifier": "land.moreno.oriontv",
  "build": {
    "frontendDist": "../src",
    "devUrl": "https://orion.moreno.land/live"
  },
  "app": {
    "windows": [
      {
        "title": "OrionTV",
        "url": "https://orion.moreno.land/live",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
